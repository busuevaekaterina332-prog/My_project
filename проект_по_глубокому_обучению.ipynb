      "execution_count": 8,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "X_train, X_val, y_train, y_val = train_test_split(X_final, y, test_size=0.2, random_state=42, stratify=y)\n",
        "\n",
        "print(f\"Размер обучающей выборки: {X_train.shape}\")"
      ],
