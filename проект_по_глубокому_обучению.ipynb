    {
      "cell_type": "code",
      "source": [
        "# Отделяем признаки\n",
        "X_numeric = train_df[numeric_cols].values.astype('float32')\n",
        "X_categorical = train_df[categorical_cols].astype(str)\n",
        "\n",
        "# Обучаем энкодер\n",
        "ohe = OneHotEncoder(drop='first', sparse_output=True) # sparse_output=True экономит память\n",
        "X_cat_encoded = ohe.fit_transform(X_categorical)\n",
        "\n",
        "# Объединяем числовые и категориальные признаки в разреженную матрицу\n",
        "X_final = scipy.sparse.hstack((X_numeric, X_cat_encoded))\n",
        "\n",
        "# Теперь X_final - это матрица для обучения\n",
        "y = train_df['class'].values"
      ],
