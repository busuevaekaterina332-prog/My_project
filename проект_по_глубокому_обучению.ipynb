    {
      "cell_type": "code",
      "source": [
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense, Dropout"
      ],
      "metadata": {
        "id": "sUKDqey_1d94"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Создаем генератор для разреженных матриц\n",
        "def sparse_generator(X, y, batch_size, is_training=True):\n",
        "    num_samples = X.shape[0]\n",
        "    indices = np.arange(num_samples)\n",
        "    while True:\n",
        "        if is_training:\n",
        "            np.random.shuffle(indices) # Перемешиваем индексы перед каждой эпохой\n",
        "        for start in range(0, num_samples, batch_size):\n",
        "            end = min(start + batch_size, num_samples)\n",
        "            batch_idx = indices[start:end]\n",
        "            # Конвертируем в dense (toarray) только маленький текущий батч\n",
        "            yield X[batch_idx].toarray(), y[batch_idx]"
      ],
      "metadata": {
        "id": "fYj0uro41i7m"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Определяем размер батча и количество шагов\n",
        "batch_size = 2048\n",
        "train_steps = int(np.ceil(X_train_scaled.shape[0] / batch_size))\n",
        "val_steps = int(np.ceil(X_val_scaled.shape[0] / batch_size))\n",
        "\n",
        "# Проверяем, сколько уникальных классов в y (бинарная или многоклассовая классификация)\n",
        "num_classes = len(np.unique(y_train))\n",
        "is_binary = (num_classes == 2)"
      ],
      "metadata": {
        "id": "HdYsTV3A1l7w"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Создание полносвязной глубокой нейронной сети\n",
        "nn_model = Sequential()\n",
        "# Входной слой и первый скрытый слой\n",
        "nn_model.add(Dense(32, activation='relu', input_shape=(X_train_scaled.shape[1],)))\n",
        "nn_model.add(Dropout(0.3)) # Dropout для предотвращения переобучения\n",
        "\n",
        "# Выходной слой\n",
        "if is_binary:\n",
        "    nn_model.add(Dense(1, activation='sigmoid'))\n",
        "    loss_function = 'binary_crossentropy'\n",
        "else:\n",
        "    nn_model.add(Dense(num_classes, activation='softmax'))\n",
        "    loss_function = 'sparse_categorical_crossentropy'\n",
        "\n",
        "nn_model.compile(optimizer='adam', loss=loss_function, metrics=['accuracy'])\n",
        "\n",
        "print(\"\\n--- Архитектура Neural Network ---\")\n",
        "nn_model.summary()"
      ],
